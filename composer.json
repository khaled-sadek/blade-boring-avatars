{
  "name": "khaled-sadek/blade-boring-avatars",
  "description": "Blade components to auto generate boring avatars based on name",
  "keywords": [
    "Blade",
    "UI",
    "Laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Khaled Sadek",
      "email": "khaledsadek286@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.9 || ^3.0",
    "laravel/pint": "^1.13",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "pestphp/pest": "^2.0 || ^3.0 || ^4.0",
    "pestphp/pest-plugin-laravel": "^2.0 || ^3.0 || ^4.0",
    "phpstan/phpstan": "^1.12 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "KhaledSadek\\BladeBoringAvatars\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "KhaledSadek\\BladeBoringAvatars\\BladeBoringAvatarsServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php ./vendor/bin/testbench package:discover --ansi"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "audit": {
      "block-insecure": false
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
